# Local development: use local. Set to production only behind HTTPS.
APP_ENV=local
APP_URL=http://localhost/marve-stock
# Reserved application secret. Generate a unique value before production deployment.
APP_KEY=replace-with-a-long-random-secret

# MySQL/MariaDB. Import database/mysql/schema.sql before starting the app.
DB_DSN="mysql:host=127.0.0.1;dbname=ngx_invest;charset=utf8mb4"
DB_USER=root
DB_PASSWORD=

# Authorized NGN Market data. Set PROVIDER=none to run without market data.
# Never expose MARKET_DATA_API_KEY to the browser or commit it.
MARKET_DATA_PROVIDER=none
MARKET_DATA_API_URL=https://api.ngnmarket.com
MARKET_DATA_API_KEY=
# Use only the entitlement granted by the provider: LIVE, DELAYED, or END_OF_DAY.
MARKET_DATA_ENTITLEMENT=DELAYED

# Reserved for a future approved broker adapter. No broker adapter is currently
# implemented, so these values cannot enable trade execution by themselves.
BROKER_PROVIDER=none
BROKER_API_URL=
BROKER_API_KEY=

# Paystack server credentials. Leave blank to keep payments disabled.
# The webhook secret may be a distinct secret or the Paystack secret key.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Comma-separated browser origins allowed to submit state-changing API requests.
TRUSTED_ORIGINS=http://localhost
